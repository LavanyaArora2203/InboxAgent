# Base URL of the FastAPI backend (api/main.py). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Single shared "demo access code" gating the UI — see src/context/AuthContext.jsx
# for why this exists (the backend has no auth of its own). Change this before
# deploying publicly; anyone who reads this file can otherwise log in.
VITE_DEMO_ACCESS_CODE=inbox-agent-demo
